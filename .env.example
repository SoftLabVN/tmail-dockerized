APP_NAME=TMail
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://imail.edu.vn
APP_DEMO=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Host Port
APP_PORT=8090

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=tmail
DB_USERNAME=tmail
DB_PASSWORD=tmail_secret_password
DB_ROOT_PASSWORD=tmail_root_password

SESSION_DRIVER=database
SESSION_LIFETIME=43800
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@imail.edu.vn"
MAIL_FROM_NAME="${APP_NAME}"

ENABLE_TMAIL_LOGS=false
API_REQUEST_LIMIT=60

# Automated Setup Options (set AUTO_INSTALL=false if you prefer the web installer at /installer)
AUTO_INSTALL=true
DEFAULT_DOMAIN=imail.edu.vn
DEFAULT_THEME=default
ADMIN_NAME="Peter Tuan Anh"
ADMIN_EMAIL=anhptt@softlab.vn
ADMIN_PASSWORD=Admin@123456

# Mail Engine (delivery or imap)
TMAIL_ENGINE=delivery
# If using IMAP, configure below:
# IMAP_HOST=mail.imail.edu.vn
# IMAP_PORT=993
# IMAP_ENCRYPTION=ssl
# IMAP_VALIDATE_CERT=false
# IMAP_USERNAME=catchall@imail.edu.vn
# IMAP_PASSWORD=your_password

